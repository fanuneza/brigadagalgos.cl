# Environment variables
# Copy to .env and fill in values as needed.
# Schema is validated via env.schema in astro.config.mjs.

# Google Tag Manager container id (public, client-side).
# Optional: falls back to SITE.gtmContainerId in src/config/site.ts when unset.
PUBLIC_GTM_ID=

# web3forms access key for the contact form (public, client-side).
# Optional: falls back to SITE.web3forms.accessKey in src/config/site.ts when unset.
PUBLIC_WEB3FORMS_KEY=

# Set to "true" only in deploys that should ping IndexNow after build.
ENABLE_INDEXNOW=false
