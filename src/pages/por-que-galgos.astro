---
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import SharedGalleryLightbox from "../components/SharedGalleryLightbox.astro";
import PageLayout from "../layouts/PageLayout.astro";
import WhyGalgosEditorial from "../components/sections/WhyGalgosEditorial.astro";
import CasesBand from "../components/sections/CasesBand.astro";
import CtaCard from "../components/sections/CtaCard.astro";
import TrackedLink from "../components/TrackedLink.astro";
import { getShuffledStorySummaries } from "../utils/dog-content";

const cases = await getShuffledStorySummaries({ limit: 3, requireGallery: true });
---

<PageLayout
  title="Por qué galgos"
  description="Por qué Brigada Galgos rescata, rehabilita y reubica específicamente galgos en Chile."
>
  <PageHero
    eyebrow="MÁS QUE UNA RAZA"
    h1="Por qué galgos"
    lead="No elegimos rescatar galgos por una preferencia de raza. Los elegimos porque vemos de cerca un abandono y una explotación que se repiten demasiado."
    leadBold="Rescatamos, rehabilitamos y reubicamos galgos en Chile para que puedan vivir, por fin, como los perros de familia que siempre merecieron ser."
  />
  <RainbowDivider />

  <WhyGalgosEditorial />
  <CasesBand cases={cases} />
  <CtaCard
    eyebrow="SIGUIENTE PASO"
    heading="Si un galgo te hace sentido, conversemos"
    body="Si crees que tu casa podría ser un buen lugar para uno de ellos, te acompañamos desde el primer mensaje. Y si todavía no es el momento de adoptar, un hogar temporal también puede cambiar por completo la historia de un rescate."
  >
    <Fragment slot="actions">
      <TrackedLink
        href="/adoptar/"
        class="btn btn--primary"
        trackEvent="cta_click"
        trackLabel="Quiero adoptar"
        trackLocation="why_galgos"
        trackDestination="/adoptar/"
        trackCategory="adoption"
      >
        Quiero adoptar
      </TrackedLink>
      <TrackedLink
        href="/hogar-temporal/"
        class="btn btn--secondary"
        trackEvent="cta_click"
        trackLabel="Puedo ser hogar temporal"
        trackLocation="why_galgos"
        trackDestination="/hogar-temporal/"
        trackCategory="foster"
      >
        Puedo ser hogar temporal
      </TrackedLink>
    </Fragment>
  </CtaCard>

  <SharedGalleryLightbox slot="afterShell" ariaLabel="Galería de casos reales" />
</PageLayout>
