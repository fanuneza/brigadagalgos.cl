---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import ContactChannels from "../components/sections/ContactChannels.astro";
import ContactForm from "../components/sections/ContactForm.astro";
---

<PageLayout
  title="Contacto para adoptar, donar o ayudar"
  description="Escríbenos por WhatsApp, correo o redes sociales para adoptar, donar o resolver tus dudas sobre Brigada Galgos."
>
  <PageHero
    eyebrow="CONTACTO"
    h1="Conversemos"
    lead="Puedes escribirnos para adoptar, ser hogar temporal, donar o hacer una pregunta general. No necesitas decidir todo antes de conversar."
  />
  <RainbowDivider />

  <ContactChannels />
  <ContactForm />
  <section class="section-padding">
    <div class="container container--narrow">
      <p class="eyebrow">PRENSA Y ALIANZAS</p>
      <p>
        Si eres medio de comunicación, clínica veterinaria, municipalidad o empresa y quieres apoyarnos, escríbenos por
        el formulario, por correo o por WhatsApp para coordinar la conversación.
      </p>
    </div>
  </section>
</PageLayout>
