---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import CtaCard from "../components/sections/CtaCard.astro";
import TrackedLink from "../components/TrackedLink.astro";
---

<PageLayout
  title="Preguntas frecuentes sobre adopción de galgos"
  description="Resolvemos tus dudas sobre adopción de galgos, hogar temporal, donaciones y convivencia. Rescatamos, rehabilitamos y reubicamos galgos en Chile."
>
  <PageHero
    eyebrow="RESPUESTAS DIRECTAS"
    h1="Preguntas frecuentes"
    lead="Sabemos que adoptar, ser hogar temporal o donar genera dudas. Aquí respondemos las que más nos hacen llegar, con la misma honestidad con la que trabajamos cada día."
  />
  <RainbowDivider />

  <FaqSection />
  <CtaCard
    weight="support"
    eyebrow="SIGUIENTE PASO"
    heading="Si un galgo te hace sentido, conversemos"
    body="Si crees que tu casa podría ser un buen lugar para uno de ellos, te acompañamos desde el primer mensaje. Y si todavía no es el momento de adoptar, un hogar temporal también puede cambiar por completo la historia de un rescate."
  >
    <Fragment slot="actions">
      <TrackedLink
        href="/adoptar/"
        class="btn btn--primary"
        trackEvent="cta_click"
        trackLabel="Quiero adoptar"
        trackLocation="why_galgos"
        trackDestination="/adoptar/"
        trackCategory="adoption"
      >
        Quiero adoptar
      </TrackedLink>
      <TrackedLink
        href="/hogar-temporal/"
        class="btn btn--secondary"
        trackEvent="cta_click"
        trackLabel="Puedo ser hogar temporal"
        trackLocation="why_galgos"
        trackDestination="/hogar-temporal/"
        trackCategory="foster"
      >
        Puedo ser hogar temporal
      </TrackedLink>
    </Fragment>
  </CtaCard>
</PageLayout>
