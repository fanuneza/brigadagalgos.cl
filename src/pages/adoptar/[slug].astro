---
import "../../styles/components/dog-card.css";
import "../../styles/components/dog-profile.css";
import { getImage } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import RainbowDivider from "../../components/RainbowDivider.astro";
import SharedPhotoGallery from "../../components/SharedPhotoGallery.astro";
import SharedGalleryLightbox from "../../components/SharedGalleryLightbox.astro";
import AdoptionProcess from "../../components/sections/AdoptionProcess.astro";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import TrackedLink from "../../components/TrackedLink.astro";
import InstagramLink from "../../components/InstagramLink.astro";
import { SITE } from "../../config/site.ts";
import {
  buildAdoptionDogCards,
  buildDogMetaDescription,
  getActiveDogs,
  type AdoptionDogEntry,
} from "../../utils/dog-content";

export async function getStaticPaths() {
  const dogs = await getActiveDogs();
  return dogs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: AdoptionDogEntry };
const [dog] = await buildAdoptionDogCards([entry]);
const metaDescription = buildDogMetaDescription(entry.data);
const adoptionFacts = dog.adoptionFacts;
const compatibilityItems = adoptionFacts
  ? [
      { label: "Niños", value: adoptionFacts.compatibility.children },
      { label: "Gatos", value: adoptionFacts.compatibility.cats },
      { label: "Perras", value: adoptionFacts.compatibility.femaleDogs },
      { label: "Perros machos", value: adoptionFacts.compatibility.maleDogs },
    ]
  : [];

const firstImage = entry.data.gallery[0];
const ogImage = firstImage
  ? (await getImage({ src: firstImage, width: 1200, height: 630, format: "jpeg", fit: "cover" })).src
  : undefined;
---

<PageLayout
  title={`${dog.name}: galgo en adopción en Chile`}
  description={metaDescription}
  ogImage={ogImage}
  ogImageAlt={`${dog.name}, galgo en adopción en Chile`}
  breadcrumbNames={{ [entry.id]: dog.name }}
>
  <section class="dog-profile section-padding">
    <div class="container">
      <p class="dog-profile__back">
        <a href="/adoptar/#galgos">Ver todos los galgos en adopción</a>
      </p>
      <div class="dog-profile__layout">
        <div class="dog-profile__gallery">
          <SharedPhotoGallery
            name={dog.name}
            photos={dog.pictures}
            id={dog.id}
            loadingPriority="eager"
            context="adopcion"
            transitionName={`dog-photo-${dog.id}`}
          />
        </div>
        <div class="dog-profile__info">
          <p class="eyebrow">GALGO EN ADOPCIÓN</p>
          <h1>{dog.name}</h1>

          <section class="dog-profile__group dog-profile__group--facts" aria-labelledby="dog-profile-facts-heading">
            <h2 id="dog-profile-facts-heading" class="dog-profile__group-heading">Así es</h2>
            <div class="dog-card__chips dog-profile__chips">
              <span class="dog-chip dog-chip--sex">{dog.sex}</span>
              <span class="dog-chip dog-chip--age">{dog.age}</span>
              <span class="dog-chip dog-chip--weight">{dog.weight}</span>
            </div>
          </section>

          <section class="dog-profile__group dog-profile__group--about" aria-labelledby="dog-profile-about-heading">
            <h2 id="dog-profile-about-heading" class="dog-profile__group-heading">Su personalidad</h2>
            <p class="dog-profile__sketch">{adoptionFacts?.personalityBehavior ?? dog.characterSketch}</p>
            <p class="dog-profile__details">{dog.details}</p>
            {
              dog.instagramUrl && (
                <InstagramLink url={dog.instagramUrl} name={dog.name} location="dog_profile" class="dog-social-link" />
              )
            }
          </section>

          {
            adoptionFacts && (
              <section class="dog-profile__group" aria-labelledby="dog-profile-compatibility-heading">
                <h2 id="dog-profile-compatibility-heading" class="dog-profile__group-heading">
                  Convivencia
                </h2>
                <ul class="dog-profile__compatibility" role="list">
                  {compatibilityItems.map((item) => (
                    <li
                      class:list={["dog-profile__compatibility-item", `dog-profile__compatibility-item--${item.value}`]}
                    >
                      <span>{item.label}</span>
                      <strong>{item.value}</strong>
                    </li>
                  ))}
                </ul>
                {compatibilityItems.some((item) => item.value === "sin información confirmada") && (
                  <p class="dog-profile__unknown-note">
                    Aún estamos conociendo esta parte de su convivencia. Escríbenos y te contamos lo que sabemos hoy.
                  </p>
                )}
              </section>
            )
          }

          {
            adoptionFacts &&
              (adoptionFacts.homeGuidance || adoptionFacts.exerciseNeeds || adoptionFacts.medicalOrSafetyNeeds) && (
                <section class="dog-profile__group" aria-labelledby="dog-profile-care-heading">
                  <h2 id="dog-profile-care-heading" class="dog-profile__group-heading">
                    Cuidados y rutina
                  </h2>
                  <dl class="dog-profile__care-list">
                    {adoptionFacts.homeGuidance && (
                      <div>
                        <dt>Hogar</dt>
                        <dd>{adoptionFacts.homeGuidance}</dd>
                      </div>
                    )}
                    {adoptionFacts.exerciseNeeds && (
                      <div>
                        <dt>Paseos</dt>
                        <dd>{adoptionFacts.exerciseNeeds}</dd>
                      </div>
                    )}
                    {adoptionFacts.medicalOrSafetyNeeds && (
                      <div>
                        <dt>Salud y seguridad</dt>
                        <dd>{adoptionFacts.medicalOrSafetyNeeds}</dd>
                      </div>
                    )}
                  </dl>
                </section>
              )
          }

          <section
            class="dog-profile__group dog-profile__group--need card card--elevated"
            aria-labelledby="dog-profile-need-heading"
          >
            <h2 id="dog-profile-need-heading" class="dog-profile__group-heading">Dónde está hoy</h2>
            {dog.location && <p class="dog-profile__location">{dog.location}</p>}
            <p class="dog-profile__need-value">{dog.currentNeed}</p>
          </section>

          <div class="dog-profile__ctas">
            <TrackedLink
              href={SITE.adoptionForm}
              class="btn btn--primary"
              newTab
              trackEvent="adoption_apply_click"
              trackLabel={`Postular - ${dog.name}`}
              trackLocation="dog_profile"
              trackDestination={SITE.adoptionForm}
              trackCategory="adoption"
              trackOutbound
            >
              Postular <span class="sr-only">por {dog.name} (abre en una nueva pestaña)</span>
            </TrackedLink>
            <WhatsAppLink
              text={`Hola, me interesa ${dog.name} y quisiera saber más sobre su adopción`}
              location="dog_profile"
              label={`Más información - ${dog.name}`}
              class="btn btn--secondary"
              data-dog-name={dog.name}
            >
              Hablar sobre {dog.name}
              <span class="sr-only">por WhatsApp</span>
            </WhatsAppLink>
            <button type="button" class="btn btn--ghost dog-profile__share" data-share-dog={dog.name}>
              <span class="link-icon link-icon--share" aria-hidden="true"></span>
              Compartir a {dog.name}
            </button>
          </div>
          <p class="dog-profile__share-live" data-share-live aria-live="polite"></p>
          <p class="dog-profile__action-note">
            Al postular revisamos tu rutina y conversamos sobre {dog.name}. Antes de una adopción coordinamos un
            encuentro y seguimos presentes durante la adaptación.
          </p>
          <p class="dog-profile__support">
            Te preguntamos por tu rutina y tu casa para que {dog.name} esté seguro, no para juzgarte. Y seguimos acompañándote
            después de la adopción.
          </p>
        </div>
      </div>
    </div>
  </section>

  <RainbowDivider />
  <AdoptionProcess variant="compact" />

  <SharedGalleryLightbox slot="afterShell" ariaLabel={`Galería de ${dog.name}`} />
</PageLayout>

<script>
  import "../../scripts/share-dog";
</script>
