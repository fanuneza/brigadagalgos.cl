---
import heroSrc from "../assets/images/hero.webp";
import Hero from "../components/sections/Hero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import MissionSection from "../components/sections/MissionSection.astro";
import HelpCards from "../components/sections/HelpCards.astro";
import ProcessStepper from "../components/sections/ProcessStepper.astro";
import StoriesSection from "../components/sections/StoriesSection.astro";
import DonationBanner from "../components/sections/DonationBanner.astro";
import WhyGalgosSection from "../components/sections/WhyGalgosSection.astro";
import TrustStatsSection from "../components/sections/TrustStatsSection.astro";
import FeaturedAdoptionDogs from "../components/sections/FeaturedAdoptionDogs.astro";
import SharedGalleryLightbox from "../components/SharedGalleryLightbox.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  buildStoryDogSummaries,
  getActiveAdoptionDogCards,
  getActiveAdoptionDogs,
  getEntriesWithGallery,
} from "../utils/dog-content";
import { buildSrcSet } from "../utils/responsive-gallery-images";
import { shuffle } from "../utils/shuffle";

const PORTRAIT_WIDTHS = [360, 540, 720];
const LANDSCAPE_WIDTHS = [640, 960, 1120];

// The hero keeps a hand-built <picture>: it is art-directed (portrait vs
// landscape crops) and needs matching preload links, which Astro's `layout`
// responsive images do not generate. The global responsiveStyles only apply to
// [data-astro-image], so there is no conflict with .hero__img.
async function buildHeroImageSources(src: ImageMetadata) {
  const [portraitAvifSrcSet, portraitWebpSrcSet, landscapeAvifSrcSet, landscapeWebpSrcSet, portraitFallback] =
    await Promise.all([
      buildSrcSet(src, "avif", PORTRAIT_WIDTHS, 50),
      buildSrcSet(src, "webp", PORTRAIT_WIDTHS, 65),
      buildSrcSet(src, "avif", LANDSCAPE_WIDTHS, 50),
      buildSrcSet(src, "webp", LANDSCAPE_WIDTHS, 65),
      getImage({ src, format: "webp", width: 540, quality: 65 }),
    ]);

  return {
    portraitAvifSrcSet,
    portraitWebpSrcSet,
    landscapeAvifSrcSet,
    landscapeWebpSrcSet,
    portraitFallbackSrc: portraitFallback.src,
  };
}

const rescueSteps = [
  {
    label: "Recibimos el aviso",
    subLabel: "Los casos suelen llegar por WhatsApp o redes sociales.",
    colorClass: "primary",
  },
  {
    label: "Rescate y traslado",
    subLabel: "Evaluamos la urgencia y movemos al galgo a un lugar seguro.",
    colorClass: "secondary",
  },
  {
    label: "Atención veterinaria integral",
    subLabel: "No solo lo básico: hacemos la evaluación y tratamiento que cada caso necesita.",
    colorClass: "warm",
  },
  {
    label: "Acogida temporal",
    subLabel: "Una familia lo recibe mientras se estabiliza y conocemos mejor su ritmo.",
    colorClass: "green",
  },
  {
    label: "Familia y acompañamiento",
    subLabel: "Buscamos una familia segura y seguimos presentes después de la adopción.",
    colorClass: "purple",
  },
];

const activeAdoptionDogs = await getActiveAdoptionDogs();
const featuredDogs = await getActiveAdoptionDogCards(3);
const successDogs: CollectionEntry<"success-dogs">[] = await getCollection("success-dogs");
const storyDogs = await buildStoryDogSummaries(
  getEntriesWithGallery(successDogs).sort((a, b) => a.data.name.localeCompare(b.data.name, "es")),
  3
);

const activeAdoptionDogsWithPhoto = getEntriesWithGallery(activeAdoptionDogs);
const heroDog = activeAdoptionDogsWithPhoto.length > 0 ? shuffle(activeAdoptionDogsWithPhoto)[0] : null;
const heroImage = heroDog?.data.gallery[0] ?? heroSrc;
const heroAlt = heroDog
  ? `${heroDog.data.name}, galgo en adopción con Brigada Galgos, mirando hacia adelante`
  : "Galgo blanco y crema con arnés amarillo, mirando con calma hacia adelante";
const heroSources = await buildHeroImageSources(heroImage);
---

<PageLayout
  title="Rescatamos galgos en todo Chile"
  description="Rescatamos, rehabilitamos y reubicamos galgos en Chile hasta encontrarles una familia segura."
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroSources.portraitAvifSrcSet}
      imagesizes="calc((100vw - 48px) / 1.75)"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroSources.landscapeAvifSrcSet}
      imagesizes="(min-width: 1200px) 528px, (min-width: 1024px) calc(50vw - 72px), calc(100vw - 48px)"
      media="(min-width: 768px)"
      fetchpriority="high"
    />
  </Fragment>
  <Hero
    sources={heroSources}
    alt={heroAlt}
    width={heroImage.width}
    height={heroImage.height}
    dogName={heroDog?.data.name}
    activeDogsCount={activeAdoptionDogs.length}
  />
  <RainbowDivider />
  <FeaturedAdoptionDogs dogs={featuredDogs} />
  <MissionSection />
  <TrustStatsSection />
  <WhyGalgosSection />
  <StoriesSection dogs={storyDogs} />
  <ProcessStepper steps={rescueSteps} />
  <HelpCards />
  <DonationBanner />
  <SharedGalleryLightbox slot="afterShell" ariaLabel="Galería de Brigada Galgos" />
</PageLayout>
