---
import "../../styles/components/blog.css";
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import RainbowDivider from "../../components/RainbowDivider.astro";
import TrackedLink from "../../components/TrackedLink.astro";
import { getReadingTimeLabel } from "../../utils/reading-time.ts";
import { SITE } from "../../config/site.ts";
import { getPublishedBlogPosts } from "../../utils/blog-content.ts";
import { buildBlogPostingGraph } from "../../utils/structured-data.ts";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((post: CollectionEntry<"blog">) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "long", year: "numeric" });
const readingTimeLabel = getReadingTimeLabel(post.body);
const heroImageUrl = post.data.heroImage ? new URL(post.data.heroImage.src, SITE.siteUrl).href : undefined;
const schema = buildBlogPostingGraph({
  url: new URL(`/blog/${post.id}/`, SITE.siteUrl).href,
  title: post.data.title,
  description: post.data.description,
  publishDate: post.data.pubDate,
  category: post.data.category,
});
const postNextSteps: Record<string, { prompt: string; href: string; label: string; category: string }> = {
  "adoptar-un-galgo-por-primera-vez": {
    prompt: "¿Quieres revisar cómo funciona el proceso antes de conversar?",
    href: "/preguntas-frecuentes/#proceso",
    label: "Conocer el proceso de adopción",
    category: "adoption",
  },
  "galgos-departamento-santiago": {
    prompt: "¿Tu duda es si un galgo puede calzar con tu rutina?",
    href: "/adoptar/",
    label: "Conocer galgos disponibles",
    category: "adoption",
  },
  "por-que-los-galgos-son-increibles-companeros": {
    prompt: "Cada galgo tiene una historia y necesidades propias.",
    href: "/adoptar/",
    label: "Conocer galgos disponibles",
    category: "adoption",
  },
};
const nextStep = postNextSteps[post.id];
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={heroImageUrl}
  ogImageAlt={post.data.heroImageAlt ?? post.data.title}
  ogType="article"
  article={{ publishedTime: post.data.pubDate, authors: [post.data.author], section: post.data.category }}
  articlePublisher={SITE.facebook}
  schema={schema}
>
  <article class="blog-post section-padding">
    <div class="container container--narrow blog-post__header">
      <a class="blog-post__top-link" href="/blog/">Volver al blog</a>
      <p class="eyebrow">BLOG</p>
      <h1>{post.data.title}</h1>
      <p class="blog-post__dek">{post.data.description}</p>
      <p class="blog-post__meta">
        {
          post.data.category && (
            <>
              <span class="blog-post__category">{post.data.category}</span>
              {" · "}
            </>
          )
        }
        Por <span class="blog-post__author">{post.data.author}</span>
        {" · "}
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
        {" · "}
        {readingTimeLabel}
      </p>
      {
        post.data.heroImage && (
          <div class="blog-post__hero-wrap">
            <Image
              src={post.data.heroImage}
              alt={post.data.heroImageAlt ?? post.data.title}
              class="blog-post__hero"
              layout="constrained"
              widths={[480, 768, 1200, 1600]}
              sizes="(min-width: 1024px) 920px, 100vw"
              quality={78}
            />
          </div>
        )
      }
    </div>
    <RainbowDivider />
    <div class="blog-post__section">
      <div class="container container--narrow">
        <div class="blog-post__body">
          <Content />
        </div>
        <p class="blog-post__back">
          <a class="blog-post__back-link" href="/blog/"> Volver al blog </a>
        </p>
      </div>
    </div>
  </article>
  {
    nextStep && (
      <section class="section-padding section--quiet blog-post__next-step">
        <div class="container container--narrow">
          <p>{nextStep.prompt}</p>
          <TrackedLink
            href={nextStep.href}
            class="btn btn--secondary"
            trackEvent="cta_click"
            trackLabel={`${nextStep.label} - Blog post`}
            trackLocation="blog_post"
            trackDestination={nextStep.href}
            trackCategory={nextStep.category}
          >
            {nextStep.label}
          </TrackedLink>
        </div>
      </section>
    )
  }
</PageLayout>
