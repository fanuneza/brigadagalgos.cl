---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import DonationCards from "../components/sections/DonationCards.astro";
import ImpactSection from "../components/sections/ImpactSection.astro";
import CtaCard from "../components/sections/CtaCard.astro";
import WhatsAppLink from "../components/WhatsAppLink.astro";

const otherWaysToHelp = [
  {
    title: "Donación de materiales",
    body: "Comida, mantas o medicamentos.",
    tone: "primary",
  },
  {
    title: "Servicios profesionales",
    body: "Veterinarios, transporte, fotografía.",
    tone: "secondary",
  },
  {
    title: "Difusión de casos",
    body: "Comparte nuestras publicaciones a traves de tus redes sociales.",
    tone: "warm",
  },
];
---

<PageLayout
  title="Dona para rescatar galgos en Chile"
  description="Apoya el rescate de galgos en Chile. Dona a través de eSponsor o revisa otras formas de aporte."
>
  <PageHero
    eyebrow="DONAR"
    h1="Tu aporte acompaña a un galgo mientras espera familia"
    lead="Las donaciones mantienen a los galgos rescatados seguros, alimentados, tratados y acompañados durante su recuperación."
    leadBold="Puedes donar una vez, hacer un aporte mensual en eSponsor o transferir directo a Brigada Galgos."
    ctaText="Voy a apoyar un galgo"
    ctaHref="#datos-transferencia"
    ctaVariant="primary"
    ctaTrackLocation="donation_hero"
    ctaTrackCategory="donation"
  />
  <RainbowDivider />

  <DonationCards />
  <ImpactSection />
  <CtaCard tail weight="quiet" eyebrow="OTRAS FORMAS DE AYUDAR" heading="También nos puedes apoyar así">
    <ul class="tail-cta__list" role="list">
      {
        otherWaysToHelp.map((way) => (
          <li class="tail-cta__item">
            <span class={`tail-cta__dot tail-cta__dot--${way.tone}`} aria-hidden="true" />
            <div>
              <h3 class="tail-cta__item-title">{way.title}</h3>
              <p>{way.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <Fragment slot="actions">
      <WhatsAppLink
        text="Hola, quiero ayudar de otra forma"
        location="help_tail_cta"
        label="Coordina por WhatsApp - Help Tail CTA"
        class="btn btn--secondary"
      >
        Coordina por WhatsApp <span class="sr-only"> (abre en una nueva pestaña)</span>
      </WhatsAppLink>
    </Fragment>
  </CtaCard>
</PageLayout>
