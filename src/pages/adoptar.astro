---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import SharedGalleryLightbox from "../components/SharedGalleryLightbox.astro";
import AdoptionGrid from "../components/sections/AdoptionGrid.astro";
import AdoptionProcess from "../components/sections/AdoptionProcess.astro";
import CtaCard from "../components/sections/CtaCard.astro";
import TrackedLink from "../components/TrackedLink.astro";
import WhatsAppLink from "../components/WhatsAppLink.astro";
import { SITE } from "../config/site.ts";
import { getActiveAdoptionDogCards } from "../utils/dog-content";

const dogs = await getActiveAdoptionDogCards();
---

<PageLayout
  title="Galgos en adopción en Chile"
  description="Conoce a los galgos en adopción y adopta al que puede ser tu compañero. Te acompañamos en todo el proceso, desde el primer mensaje hasta la llegada a casa."
>
  <PageHero
    eyebrow="GALGOS EN ADOPCIÓN"
    h1="Adopta un galgo en Chile"
    lead="Los conocemos de cerca y te acompañamos en todo el proceso de adopción, desde tu primer mensaje hasta los primeros días en casa."
    ctaText="Ver galgos en adopción"
    ctaHref="#galgos"
    ctaVariant="secondary"
    ctaTrackLabel="Ver galgos en adopción - Adoption Hero"
    ctaTrackLocation="adoption_hero"
    ctaTrackCategory="adoption"
  />
  <RainbowDivider />

  <section id="galgos" class="section-padding section--lead">
    <div class="container">
      <div class="adoption-intro">
        <p class="eyebrow eyebrow--lead">EN ADOPCIÓN</p>
        <h2 class="adoption-intro__title">Los galgos que hoy esperan familia</h2>
        <p class="adoption-intro__lead t-lead">
          Cada uno de estos galgos en adopción llega con una historia y un ritmo propio. Aquí te mostramos a quienes ya
          están listos para conocerte.
        </p>
      </div>
      <AdoptionGrid dogs={dogs} />
    </div>
  </section>

  <AdoptionProcess />
  <CtaCard
    tail
    weight="support"
    eyebrow="SIGUIENTE PASO"
    heading="¿Quieres hablarlo antes de postular?"
    body="El formulario abre en una nueva pestaña. Ahí nos cuentas sobre tu rutina, tu casa y los animales con que vives para orientarte antes de avanzar."
  >
    <Fragment slot="actions">
      <TrackedLink
        href={SITE.adoptionForm}
        class="btn btn--primary"
        newTab
        trackEvent="adoption_apply_click"
        trackLabel="Postular - Adoption Tail CTA"
        trackLocation="tail_cta"
        trackDestination={SITE.adoptionForm}
        trackCategory="adoption"
        trackOutbound
      >
        Postular <span class="sr-only"> (abre en una nueva pestaña)</span>
      </TrackedLink>
      <WhatsAppLink
        text="Hola, quisiera saber más sobre adopción"
        location="tail_cta"
        label="Más información - Adoption Tail CTA"
        class="btn btn--secondary"
      >
        Más información <span class="sr-only">sobre adopción</span>
      </WhatsAppLink>
    </Fragment>
    <p slot="aside" class="cta-card__aside">
      ¿Dudas sobre costos, departamento, niños u otros animales?{" "}
      <a href="/preguntas-frecuentes/">Revisa las preguntas frecuentes</a>.
    </p>
  </CtaCard>

  <SharedGalleryLightbox slot="afterShell" ariaLabel="Galería de adopción" />
</PageLayout>
