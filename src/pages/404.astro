---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import RainbowDivider from "../components/RainbowDivider.astro";
import FuzzyRedirect from "@jdevalk/astro-seo-graph/FuzzyRedirect.astro";
---

<PageLayout
  title="Página no encontrada"
  description="No encontramos la página que buscas. Vuelve al inicio o explora los galgos disponibles para adopción."
>
  <PageHero
    eyebrow="ERROR 404"
    h1="No encontramos esta página"
    lead="Puede que el enlace esté roto o que el contenido se haya movido. Te dejamos algunas rutas para seguir."
    ctaText="Ver galgos en adopción"
    ctaHref="/adoptar/"
    ctaVariant="primary"
    ctaTrackLabel="Ver galgos en adopción - 404"
    ctaTrackLocation="not_found"
    ctaTrackCategory="adoption"
  />
  <div class="not-found-redirect">
    <FuzzyRedirect />
  </div>
  <RainbowDivider />
  <section class="section-padding">
    <div class="container container--narrow">
      <ul class="requisitos-list">
        <li><a href="/">Volver al inicio</a></li>
        <li><a href="/hogar-temporal/">Postular a hogar temporal</a></li>
        <li><a href="/donar/">Apoyar el rescate</a></li>
        <li><a href="/contacto/">Escribirnos</a></li>
      </ul>
    </div>
  </section>
</PageLayout>
