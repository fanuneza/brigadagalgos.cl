---
import { SITE, FOOTER_LINKS } from "../config/site.ts";
import TrackedLink from "./TrackedLink.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import InstagramIcon from "../assets/icons/instagram.svg";
import FacebookIcon from "../assets/icons/facebook.svg";
import HeartIcon from "../assets/icons/heart.svg";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__brand-link">
        <img
          src="/images/brigada-galgos-logo.webp"
          alt=""
          aria-hidden="true"
          class="footer__logo"
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
        <span class="footer__brand-name">Fundación<br />Brigada Galgos</span>
      </a>
      <div class="footer__tagline">
        <p>Rescatamos galgos en todo Chile y los acompañamos hasta su hogar definitivo.</p>
        <p class="footer__brand-legal">&copy; {currentYear} Fundación Brigada Galgos</p>
        <p class="footer__brand-legal">RUT 65.132.425-4</p>
      </div>
    </div>

    <div class="footer__contact">
      <h2 class="footer__section-title">Contacto</h2>
      <ul class="footer__list">
        <li>
          <a href={`mailto:${SITE.email}`} class="footer__link">
            {SITE.email}
          </a>
        </li>
        <li>
          <WhatsAppLink
            text="Hola, quiero hablar con Brigada Galgos"
            location="footer"
            label="WhatsApp Footer"
            class="footer__link"
          >
            WhatsApp {SITE.whatsappPhone}<span class="sr-only"> (abre en una nueva pestaña)</span>
          </WhatsAppLink>
        </li>
      </ul>
      <div class="footer__social">
        <TrackedLink
          href={SITE.instagram}
          aria-label="Instagram (abre en una nueva pestaña)"
          class="footer__social-link"
          data-external-indicator="off"
          newTab
        >
          <InstagramIcon class="footer__social-icon" width={36} height={36} aria-hidden="true" />
        </TrackedLink>
        <TrackedLink
          href={SITE.facebook}
          aria-label="Facebook (abre en una nueva pestaña)"
          class="footer__social-link"
          data-external-indicator="off"
          newTab
        >
          <FacebookIcon class="footer__social-icon" width={36} height={36} aria-hidden="true" />
        </TrackedLink>
      </div>
    </div>

    <div class="footer__nav">
      <h2 class="footer__section-title">Navegar</h2>
      <ul class="footer__list">
        {
          FOOTER_LINKS.map(({ href, label }) => (
            <li>
              <a href={href} class="footer__link">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <div class="footer__copy">
        <p>
          Sitio web hecho con{" "}
          <HeartIcon class="footer__heart-icon" width={16} height={16} aria-hidden="true" />{" "}
          por{" "}
          <TrackedLink
            href="https://fnunez.cl/?utm_source=brigadagalgos.cl&utm_medium=referral&utm_campaign=credit_footer"
            aria-label="Abrir el sitio de Fabián Núñez en una pestaña nueva"
            newTab
          >
            Fabián Núñez
          </TrackedLink>
        </p>
      </div>
      <div class="footer__legal">
        <a href="/politica-de-cookies/" class="footer__legal-link">Política de cookies</a>
        <button type="button" class="footer__legal-button" id="cookie-manage-btn"
          >Gestionar preferencias de cookies</button
        >
      </div>
      <TrackedLink
        href="/donar/"
        class="btn btn--secondary footer__esponsor-btn"
        trackEvent="cta_click"
        trackLabel="Voy a apoyar un galgo"
        trackLocation="footer"
        trackDestination="/donar/"
        trackCategory="donation"
      >
        Voy a apoyar un galgo
      </TrackedLink>
    </div>
  </div>
</footer>
