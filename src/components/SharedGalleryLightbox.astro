---
import "../styles/components/shared-gallery.css";

interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Galería de fotos" } = Astro.props;
---

<dialog class="gallery-lightbox" data-gallery-lightbox aria-label={ariaLabel}>
  <button type="button" class="gallery-lightbox__close" data-gallery-lightbox-close aria-label="Cerrar galería">
    <span aria-hidden="true">&times;</span>
  </button>
  <button
    type="button"
    class="gallery-lightbox__nav gallery-lightbox__nav--prev"
    data-gallery-lightbox-prev
    aria-label="Ver foto anterior"
  >
    <span aria-hidden="true">&lsaquo;</span>
  </button>
  <figure class="gallery-lightbox__figure">
    <img class="gallery-lightbox__image" data-gallery-lightbox-image alt="" />
    <figcaption class="gallery-lightbox__caption" data-gallery-lightbox-caption></figcaption>
  </figure>
  <button
    type="button"
    class="gallery-lightbox__nav gallery-lightbox__nav--next"
    data-gallery-lightbox-next
    aria-label="Ver foto siguiente"
  >
    <span aria-hidden="true">&rsaquo;</span>
  </button>
</dialog>

<script>
  import "../scripts/gallery-lightbox";
</script>
