---
import { SITE, NAVBAR_DESKTOP_LINKS, NAVBAR_INFORMATION_LINKS, NAVBAR_LINKS } from "../config/site.ts";
import TrackedLink from "./TrackedLink.astro";
import WhatsAppIcon from "../assets/icons/whatsapp.svg";
import InstagramIcon from "../assets/icons/instagram.svg";
import FacebookIcon from "../assets/icons/facebook.svg";

const { pathname } = Astro.url;
const drawerNav = NAVBAR_LINKS;
const desktopNav = NAVBAR_DESKTOP_LINKS;
const informationNav = NAVBAR_INFORMATION_LINKS;
---

<header class="navbar" data-navbar transition:persist>
  <div class="navbar__inner container">
    <a
      href="/"
      class="navbar__brand"
      aria-label="Brigada Galgos - inicio"
      data-track-event="navigation_click"
      data-track-label="logo"
      data-track-location="navbar"
      data-track-destination="/"
    >
      <img
        src="/images/brigada-galgos-logo.webp"
        alt=""
        aria-hidden="true"
        class="navbar__mark"
        width="40"
        height="40"
        loading="eager"
        decoding="async"
      />
      <span class="navbar__name">Brigada Galgos</span>
    </a>

    <nav class="navbar__nav" aria-label="Navegación principal">
      {
        desktopNav.slice(0, 1).map(({ href, label }) => (
          <a
            href={href}
            class="navbar__link"
            aria-current={pathname === href ? "page" : undefined}
            data-track-event="navigation_click"
            data-track-label={label}
            data-track-location="desktop_nav"
            data-track-destination={href}
          >
            {label}
          </a>
        ))
      }
      <details class="navbar__information">
        <summary class="navbar__link">Información</summary>
        <div class="navbar__information-menu">
          {
            informationNav.map(({ href, label }) => (
              <a
                href={href}
                class="navbar__link navbar__information-link"
                aria-current={pathname === href ? "page" : undefined}
                data-track-event="navigation_click"
                data-track-label={label}
                data-track-location="desktop_nav"
                data-track-destination={href}
              >
                {label}
              </a>
            ))
          }
        </div>
      </details>
      {
        desktopNav.slice(1).map(({ href, label }) => (
          <a
            href={href}
            class="navbar__link"
            aria-current={pathname === href ? "page" : undefined}
            data-track-event="navigation_click"
            data-track-label={label}
            data-track-location="desktop_nav"
            data-track-destination={href}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="theme-toggle navbar__theme-toggle"
      data-theme-toggle
      aria-label="Cambiar a modo oscuro"
      aria-pressed="false"
    >
      <svg
        class="theme-toggle__moon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg
        class="theme-toggle__sun"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="5"></line><line
          x1="12"
          y1="19"
          x2="12"
          y2="22"></line><line x1="2" y1="12" x2="5" y2="12"></line><line x1="19" y1="12" x2="22" y2="12"></line><line
          x1="5.64"
          y1="5.64"
          x2="7.76"
          y2="7.76"></line><line x1="16.24" y1="16.24" x2="18.36" y2="18.36"></line><line
          x1="5.64"
          y1="18.36"
          x2="7.76"
          y2="16.24"></line><line x1="16.24" y1="7.76" x2="18.36" y2="5.64"></line>
      </svg>
    </button>

    <a
      href="/donar/"
      class="btn btn--secondary navbar__cta"
      data-track-event="cta_click"
      data-track-label="Apóyanos"
      data-track-location="navbar"
      data-track-destination="/donar/"
      data-track-category="donation"
    >
      Apoyar
    </a>

    <button
      class="navbar__hamburger"
      data-hamburger
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navbar-drawer"
    >
      <span class="hamburger__bar"></span>
      <span class="hamburger__bar"></span>
      <span class="hamburger__bar"></span>
    </button>
  </div>

  <div class="navbar__backdrop" data-backdrop aria-hidden="true"></div>

  <div
    class="navbar__drawer"
    id="navbar-drawer"
    data-drawer
    hidden
    inert
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
  >
    <button class="drawer__close" data-close aria-label="Cerrar menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      </svg>
    </button>

    <nav aria-label="Menú móvil">
      {
        drawerNav.map(({ href, label }) => (
          <a
            href={href}
            class="drawer__link"
            aria-current={pathname === href ? "page" : undefined}
            data-track-event="navigation_click"
            data-track-label={label}
            data-track-location="mobile_drawer"
            data-track-destination={href}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <hr class="drawer__separator" />

    <a
      href="/donar/"
      class="btn btn--secondary drawer__cta"
      data-track-event="cta_click"
      data-track-label="Voy a apoyar un galgo"
      data-track-location="mobile_drawer"
      data-track-destination="/donar/"
      data-track-category="donation"
    >
      Voy a apoyar un galgo
    </a>

    <div class="drawer__social">
      <TrackedLink
        href={SITE.whatsapp}
        aria-label="WhatsApp"
        newTab
        hideExternalIndicator
        trackEvent="social_click"
        trackLabel="WhatsApp"
        trackLocation="mobile_drawer"
        trackDestination={SITE.whatsapp}
        trackCategory="whatsapp"
        trackOutbound
      >
        <WhatsAppIcon class="drawer__social-icon" width={24} height={24} aria-hidden="true" />
      </TrackedLink>
      <TrackedLink
        href={SITE.instagram}
        aria-label="Instagram"
        newTab
        hideExternalIndicator
        trackEvent="social_click"
        trackLabel="Instagram"
        trackLocation="mobile_drawer"
        trackDestination={SITE.instagram}
        trackCategory="instagram"
        trackOutbound
      >
        <InstagramIcon class="drawer__social-icon" width={24} height={24} aria-hidden="true" />
      </TrackedLink>
      <TrackedLink
        href={SITE.facebook}
        aria-label="Facebook"
        newTab
        hideExternalIndicator
        trackEvent="social_click"
        trackLabel="Facebook"
        trackLocation="mobile_drawer"
        trackDestination={SITE.facebook}
        trackCategory="facebook"
        trackOutbound
      >
        <FacebookIcon class="drawer__social-icon" width={24} height={24} aria-hidden="true" />
      </TrackedLink>
    </div>
  </div>
</header>

<script>
  import "../scripts/navbar";
</script>
