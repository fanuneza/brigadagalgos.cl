---
import SharedPhotoGallery from "./SharedPhotoGallery.astro";
import InstagramLink from "./InstagramLink.astro";
import type { StoryDogSummary } from "../utils/dog-content";

interface Props {
  story: StoryDogSummary;
  location: string;
  summary?: boolean;
  loadingPriority?: "eager" | "lazy";
  gallery?: "full" | "single";
}

const { story, location, loadingPriority = "lazy", gallery = "full" } = Astro.props;
const featuredPhoto = story.photos[0];
---

<article
  class="story-card"
  data-story-card
  data-story-id={story.id}
  data-story-name={story.name}
  data-story-location={location}
>
  {
    gallery === "full" && story.photos.length > 0 ? (
      <SharedPhotoGallery
        name={story.name}
        photos={story.photos}
        id={story.id}
        loadingPriority={loadingPriority}
        context="exito"
        transitionName={`story-photo-${story.id}`}
      />
    ) : (
      featuredPhoto && (
        <div class="story-card__photo story-card__photo--single">
          <picture>
            {featuredPhoto.cardAvifSrcSet && (
              <source srcset={featuredPhoto.cardAvifSrcSet} sizes={featuredPhoto.cardSizes} type="image/avif" />
            )}
            <img
              src={featuredPhoto.cardFallbackSrc}
              alt={featuredPhoto.alt ?? `${story.name}, historia de adopción`}
              class="story-card__img"
              loading={loadingPriority}
              decoding="async"
              fetchpriority={loadingPriority === "eager" ? "high" : undefined}
              width="350"
              height="350"
            />
          </picture>
        </div>
      )
    )
  }
  <div
    class="story-card__body"
    data-track-event="story_click"
    data-track-label={story.name}
    data-track-location={location}
    data-track-destination={`/casos-de-exito/#${story.id}`}
    data-story-id={story.id}
    data-story-name={story.name}
  >
    <h3 class="story-card__name t-card-title" id={story.id}>{story.name}</h3>
    <p class="story-card__quote t-small-muted">{story.cardStory}</p>
    {
      story.instagramUrl && (
        <InstagramLink
          url={story.instagramUrl}
          name={story.name}
          location={location}
          class="story-card__social dog-social-link"
        />
      )
    }
  </div>
</article>
