---
import "../styles/components/dog-card.css";
import type { AdoptionDogCard } from "../utils/dog-content";
import SharedPhotoGallery from "./SharedPhotoGallery.astro";
import TrackedLink from "./TrackedLink.astro";

interface Props {
  dog: AdoptionDogCard;
  variant: "featured" | "grid";
  loadingPriority?: "eager" | "lazy";
}

const { dog, variant, loadingPriority = "lazy" } = Astro.props;
const profileHref = `/adoptar/${dog.id}/`;
const trackLocation = variant === "featured" ? "homepage_featured_adoptions" : "dog_card";
const listingPhoto = dog.pictures[0];
const compatibility = dog.adoptionFacts?.compatibility;
const compatibilitySummary = compatibility
  ? [
      compatibility.children !== "sin información confirmada" && `niños: ${compatibility.children}`,
      compatibility.cats !== "sin información confirmada" && `gatos: ${compatibility.cats}`,
      compatibility.femaleDogs !== "sin información confirmada" && `perras: ${compatibility.femaleDogs}`,
      compatibility.maleDogs !== "sin información confirmada" && `machos: ${compatibility.maleDogs}`,
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
const cardSummary = dog.characterSketch;
---

{
  variant === "featured" ? (
    <>
      {dog.pictures.length > 0 && (
        <SharedPhotoGallery
          name={dog.name}
          photos={dog.pictures}
          id={`home-${dog.id}`}
          loadingPriority={loadingPriority}
          context="adopcion"
          transitionName={`dog-photo-${dog.id}`}
        />
      )}
      <div class="featured-adoption__body">
        <div>
          <p class="featured-adoption__need">{dog.currentNeed}</p>
          <h3 class="t-card-title">
            <TrackedLink
              href={profileHref}
              trackEvent="dog_profile_click"
              trackLabel={dog.name}
              trackLocation={trackLocation}
              trackDestination={profileHref}
              trackCategory="adoption"
            >
              {dog.name}
            </TrackedLink>
          </h3>
          <div class="dog-card__chips featured-adoption__chips">
            <span class="dog-chip dog-chip--sex">{dog.sex}</span>
            <span class="dog-chip dog-chip--age">{dog.age}</span>
            <span class="dog-chip dog-chip--weight">{dog.weight}</span>
          </div>
          <p class="featured-adoption__sketch">{dog.characterSketch}</p>
        </div>
        <TrackedLink
          href={profileHref}
          class="btn btn--ghost featured-adoption__profile"
          trackEvent="dog_profile_click"
          trackLabel={`Ver ficha - ${dog.name}`}
          trackLocation={trackLocation}
          trackDestination={profileHref}
          trackCategory="adoption"
        >
          Ver ficha de {dog.name}
        </TrackedLink>
      </div>
    </>
  ) : (
    <>
      {listingPhoto && (
        <div class="dog-card__photo">
          <picture>
            {listingPhoto.cardAvifSrcSet && (
              <source srcset={listingPhoto.cardAvifSrcSet} sizes={listingPhoto.cardSizes} type="image/avif" />
            )}
            <img
              src={listingPhoto.cardFallbackSrc}
              alt={listingPhoto.alt ?? `${dog.name}, galgo en adopción en Chile`}
              class="dog-card__image"
              loading={loadingPriority}
              decoding="async"
              fetchpriority={loadingPriority === "eager" ? "high" : undefined}
              width="350"
              height="350"
              transition:name={`dog-photo-${dog.id}`}
            />
          </picture>
        </div>
      )}
      <div class="dog-card__body">
        <div class="dog-card__content">
          <div class="dog-card__header">
            <p class="dog-card__need">{dog.currentNeed}</p>
            <h3 class="dog-card__name t-card-title">
              <TrackedLink
                href={profileHref}
                trackEvent="dog_profile_click"
                trackLabel={dog.name}
                trackLocation={trackLocation}
                trackDestination={profileHref}
                trackCategory="adoption"
              >
                {dog.name}
              </TrackedLink>
            </h3>
            <div class="dog-card__chips">
              <span class="dog-chip dog-chip--sex">{dog.sex}</span>
              <span class="dog-chip dog-chip--age">{dog.age}</span>
              <span class="dog-chip dog-chip--weight">{dog.weight}</span>
            </div>
          </div>
          <p class="dog-card__sketch">{cardSummary}</p>
          {compatibilitySummary && <p class="dog-card__compatibility">Convivencia: {compatibilitySummary}.</p>}
        </div>
        <TrackedLink
          href={profileHref}
          class="btn btn--ghost dog-card__profile"
          trackEvent="dog_profile_click"
          trackLabel={`Conocer a ${dog.name}`}
          trackLocation={trackLocation}
          trackDestination={profileHref}
          trackCategory="adoption"
        >
          Conocer a {dog.name}
        </TrackedLink>
      </div>
    </>
  )
}
