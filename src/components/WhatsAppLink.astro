---
import { SITE } from "../config/site.ts";
import type { HTMLAttributes } from "astro/types";
import TrackedLink from "./TrackedLink.astro";

interface Props extends HTMLAttributes<"a"> {
  text: string;
  location: string;
  label?: string;
  intent?: "adoption";
}

const { text, location, label, intent, class: className, ...anchorProps } = Astro.props;
const href = `${SITE.whatsapp}?text=${encodeURIComponent(text)}`;
const classes = ["whatsapp-link", className].filter(Boolean).join(" ");
const trackLabel = intent === "adoption" ? "Conversar sobre adopción" : (label ?? "Escríbenos por WhatsApp");
---

<TrackedLink
  {...anchorProps}
  href={href}
  class={classes}
  newTab
  hideExternalIndicator
  trackEvent="whatsapp_click"
  trackLabel={trackLabel}
  trackLocation={location}
  trackDestination={href}
  trackCategory="whatsapp"
  trackOutbound
  data-whatsapp-location={location}
  data-adoption-intent={intent === "adoption" ? "true" : undefined}
>
  <slot />
  <span class="link-icon link-icon--whatsapp" aria-hidden="true"></span>
</TrackedLink>
