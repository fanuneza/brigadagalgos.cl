---
import "../../styles/components/faq.css";
import { faqPairs, faqGroups } from "../../config/faq";
---

<section class="faq-section" aria-label="Preguntas frecuentes">
  <div class="container container--narrow">
    <nav class="faq-topic-index" aria-label="Temas de preguntas frecuentes">
      <h2 class="faq-topic-index__title">Encuentra tu duda</h2>
      <ul class="faq-topic-index__list" role="list">
        {
          faqGroups.map((group) => (
            <li>
              <a href={`#${group.id}`}>{group.topicLabel}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      faqGroups.map((group) => (
        <section class="faq-group" id={group.id} aria-labelledby={`group-${group.id}`}>
          <h2 id={`group-${group.id}`}>{group.eyebrow}</h2>

          {group.ids.map((idx) => {
            const item = faqPairs[idx];
            return (
              <article class="faq-item" id={item.id}>
                <h3 class="faq-question">
                  <a href={`#${item.id}`} aria-label={`Enlace directo a: ${item.question}`}>
                    {item.question}
                  </a>
                </h3>
                <div class="faq-answer">
                  <p>{item.answer}</p>
                  {item.details && (
                    <ol>
                      {item.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ol>
                  )}
                </div>
              </article>
            );
          })}

          {
            group.links && (
              <nav class="faq-group__next-steps" aria-label={`Siguientes pasos sobre ${group.topicLabel}`}>
                <span>También puedes</span>
                <ul role="list">
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </section>
      ))
    }
  </div>
</section>
