---
interface Props {
  eyebrow: string;
  heading: string;
  body?: string;
  bodyClass?: string;
  tail?: boolean;
}

const { eyebrow, heading, body, bodyClass, tail = false } = Astro.props;
---

<section class={tail ? "section-padding tail-cta end-cta" : "section-padding end-cta"}>
  <div class="container container--narrow">
    <div class="cta-card cta-card--end">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
      {body && <p class={bodyClass}>{body}</p>}
      <slot />
      <div class="cta-card__actions">
        <slot name="actions" />
      </div>
      <slot name="aside" />
    </div>
  </div>
</section>
