---
import "../../styles/components/help-cards.css";
import HogarTemporalIcon from "../../assets/icons/hogar-temporal.svg";
import DonarIcon from "../../assets/icons/donar.svg";
---

<section class="section-padding section--quiet help-cards" data-track-section="help_cards">
  <div class="container">
    <div class="help-cards__header">
      <p class="eyebrow eyebrow--quiet">TAMBIÉN PUEDES</p>
      <h2 class="help-cards__heading section-heading section-heading--quiet">Sostener un rescate de otras formas</h2>
    </div>

    <div class="help-cards__grid">
      <article class="help-card">
        <div class="icon-circle icon-circle--secondary" aria-hidden="true">
          <HogarTemporalIcon class="icon-circle__image" width={24} height={24} aria-hidden="true" />
        </div>
        <h3 class="help-card__title t-card-title">Ser hogar temporal</h3>
        <p class="help-card__desc t-card-body">
          Recibe un galgo mientras encuentra familia. Evaluamos contigo tiempos, seguridad y convivencia.
        </p>
        <a
          href="/hogar-temporal/"
          class="help-card__cta"
          data-track-event="cta_click"
          data-track-label="Puedo ser hogar temporal"
          data-track-location="help_cards"
          data-track-destination="/hogar-temporal/"
          data-track-category="foster"
        >
          Puedo ser hogar temporal &rarr;
        </a>
      </article>

      <article class="help-card">
        <div class="icon-circle icon-circle--warm" aria-hidden="true">
          <DonarIcon class="icon-circle__image" width={24} height={24} aria-hidden="true" />
        </div>
        <h3 class="help-card__title t-card-title">Donar</h3>
        <p class="help-card__desc t-card-body">
          Tu aporte sostiene comida, atención veterinaria, traslados y acogida mientras esperan familia.
        </p>
        <a
          href="/donar/"
          class="help-card__cta"
          data-track-event="cta_click"
          data-track-label="Voy a apoyar un galgo"
          data-track-location="help_cards"
          data-track-destination="/donar/"
          data-track-category="donation"
        >
          Voy a apoyar un galgo &rarr;
        </a>
      </article>
    </div>
  </div>
</section>
