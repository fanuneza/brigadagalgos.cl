---
import "../../styles/components/hogar-temporal.css";
import { SITE } from "../../config/site.ts";
import WhatsAppLink from "../../components/WhatsAppLink.astro";
import TrackedLink from "../../components/TrackedLink.astro";
---

<section id="form" class="section-padding">
  <div class="container container--narrow">
    <div class="foster-cta cta-card cta-card--end">
      <p class="eyebrow">POSTULAR</p>
      <h2>¿Puedes abrir un espacio temporal?</h2>
      <p class="foster-cta__intro">
        El formulario de Google se abre en una nueva pestaña. Ahí nos cuentas tu disponibilidad, tu casa, quiénes viven
        contigo y tu experiencia con perros para que podamos preparar una acogida segura. Si tienes dudas, escríbenos
        primero: no esperamos que tengas todo claro desde el primer mensaje.
      </p>
      <div class="cta-card__actions">
        <TrackedLink
          href={SITE.fosterForm}
          class="btn btn--primary"
          newTab
          trackEvent="foster_apply_click"
          trackLabel="Postula aquí - Foster Application"
          trackLocation="foster_cta"
          trackDestination={SITE.fosterForm}
          trackCategory="foster"
          trackOutbound
          data-application-form-url={SITE.fosterForm}
        >
          Puedo ser hogar temporal <span class="sr-only"> (abre en una nueva pestaña)</span>
        </TrackedLink>
      </div>
      <p class="foster-cta__fallback">
        ¿Prefieres hablar primero?{" "}
        <WhatsAppLink
          text="Hola, quisiera ser hogar temporal"
          location="foster_cta"
          label="Escríbenos directo por WhatsApp - Foster Fallback"
          class="text-link foster-cta__whatsapp-link"
        >
          Escríbenos directo por WhatsApp
        </WhatsAppLink>
      </p>
      <p class="cta-card__aside">
        Antes de postular también puedes{" "}
        <a href="/preguntas-frecuentes/">revisar las preguntas frecuentes</a>.
      </p>
    </div>
  </div>
</section>
